prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include/x86_64-linux-gnu

Name: libswresample
Description: FFmpeg audio resampling library
Version: 6.1.100
Requires: 
